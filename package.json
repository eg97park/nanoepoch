{
  "name": "nanoepoch",
  "version": "0.4.0",
  "description": "Nanosecond Unix-epoch timestamps read fresh from the OS realtime clock on every call, returned as a BigInt.",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "gypfile": false,
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "src/",
    "prebuilds/",
    "test/smoke.test.mjs",
    "build-recipe/",
    "BUILD-INFO.json"
  ],
  "scripts": {
    "dev:build": "node-gyp rebuild",
    "make-prebuild": "node scripts/prebuild.mjs",
    "merge-build-info": "node scripts/build-info.mjs --merge",
    "test": "node --test",
    "test:smoke": "node --test test/smoke.test.mjs",
    "bench": "node bench/compare.mjs",
    "attw": "npx --yes --ignore-scripts @arethetypeswrong/cli@0.18.5 --pack . --profile node16",
    "prepublishOnly": "node scripts/verify-prebuilds.mjs"
  },
  "devDependencies": {
    "mitata": "^1.0.34",
    "node-gyp": "^13.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nanosecond",
    "timestamp",
    "epoch",
    "unix-time",
    "wall-clock",
    "clock_gettime",
    "CLOCK_REALTIME",
    "GetSystemTimePreciseAsFileTime",
    "bigint",
    "hrtime"
  ],
  "author": "Eungyu Park <ekpark97.dev@gmail.com> (https://github.com/eg97park)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eg97park/nanoepoch.git"
  },
  "bugs": {
    "url": "https://github.com/eg97park/nanoepoch/issues"
  },
  "homepage": "https://github.com/eg97park/nanoepoch#readme",
  "license": "MIT",
  "sideEffects": [
    "./index.js",
    "./index.mjs"
  ]
}
